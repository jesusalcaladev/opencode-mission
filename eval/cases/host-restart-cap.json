{
  "id": "host-restart-cap",
  "mode": "host-restart",
  "objective": "The restart ceiling prevents restart loops",
  "criteria": [{ "id": "ok", "cmd": "node --version", "expect": "exit0", "timeout_ms": 5000 }],
  "tasks": [],
  "settings": { "status": "running", "stage": "done", "max_turns": 2 },
  "policy": { "seedRestart": { "attempts": 1, "next_at": 0 } },
  "max": 1,
  "command": "node -e \"require('fs').writeFileSync(require('path').join(process.env.MISSION_RESTART_ROOT,'restarted.txt'),'ok')\"",
  "expect": {
    "status": "host-restart",
    "restart_marker": false,
    "restart_attempts": 1,
    "restarts": 0
  }
}
