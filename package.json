{
  "name": "opencode-mission",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Autonomous mission supervisor for OpenCode: plans work, dispatches parallel sub-agents, and verifies executable criteria until the task is actually done.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "agent",
    "autonomous-agent",
    "subagents",
    "verification",
    "long-running-tasks"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jesusalcaladev/opencode-mission.git"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./src/index.js",
    "./tui": "./src/tui.tsx"
  },
  "files": [
    "src",
    "demos",
    "CONTRACT.md",
    "ARCHITECTURE.md",
    "RUNBOOK.md",
    "README.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "dependencies": {
    "@opencode/plugin": "2.3.2"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@opencode/theme": "2.3.2",
    "@opentui/core": "0.8.4",
    "@opentui/solid": "0.8.4",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "solid-js": "^1.9.4",
    "typescript": "^5.7.2"
  },
  "scripts": {
    "check": "node scripts/check-syntax.mjs && node scripts/check-architecture.mjs",
    "test": "node --test test/*.test.js",
    "test:watch": "node --test --watch test/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "coverage": "node --test --experimental-test-coverage --test-coverage-lines=87 --test-coverage-branches=69 --test-coverage-functions=82.5 test/*.test.js",
    "watchdog": "node scripts/mission-watchdog.mjs --once",
    "eval": "node scripts/mission-eval.mjs",
    "quality": "npm run check && npm run lint && npm run format:check && npm run typecheck && npm run coverage"
  }
}
