{
  "name": "opencode-mission",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Autonomous mission supervisor for OpenCode: plans work, dispatches parallel sub-agents, and verifies executable criteria until the task is actually done.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "agent",
    "autonomous-agent",
    "subagents",
    "verification",
    "long-running-tasks"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jesusalcaladev/opencode-mission.git"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./src/index.js",
    "./tui": "./src/tui.tsx"
  },
  "files": [
    "src",
    "demos",
    "CONTRACT.md",
    "ARCHITECTURE.md",
    "RUNBOOK.md",
    "README.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "dependencies": {
    "@opencode/plugin": "2.3.2"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  },
  "scripts": {
    "check": "for f in src/*.js src/mission/*.js src/supervisor/*.js test/*.test.js; do node --check \"$f\" || exit 1; done",
    "test": "node --test test/*.test.js",
    "test:watch": "node --test --watch test/*.test.js"
  }
}
